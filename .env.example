# Copy to .env and fill in. Never commit .env.

# Needed for the coach, model-written plans and tests (ANTHROPIC_AUTH_TOKEN also works).
# Easier: leave it empty and add the key in the app (Settings → AI key). A key here wins over that one.
ANTHROPIC_API_KEY=

# Models (optional)
# CTU_MODEL=claude-sonnet-5-5          # planning and tests
# CTU_COACH_MODEL=claude-haiku-5-5     # default coach chat model (also changeable in coach settings)

# Paths (optional; defaults shown). The study repo, COACH.md and Kintsugi belong to the built-in CTU plan;
# a plan made in plan setup doesn't need them (CTU_STUDY_REPO only if you want your own repo watched).
# CTU_STUDY_REPO=~/quaimlres_road               # watched, compiled; PROGRESS.md and math/log.md
# CTU_COACH_MD=~/Custom/Projects/ctu-plan/COACH.md
# CTU_KINTSUGI=~/Custom/Projects/kintsugi       # read only, for the in-app reader
# CTU_DATA_DIR=~/.local/share/waymark         # the data folder (default; Windows: %APPDATA%\Waymark).
#                                              # An install that already has backend/data/ctu.db keeps using it.
# CTU_DB=~/.local/share/waymark/ctu.db        # the database alone; pictures and backups/ go next to it

# Khan Academy content through Kolibri (optional; ./setup-khan.sh sets it up, defaults shown)
# CTU_KOLIBRI_HOME=~/.local/share/ctu-app/kolibri   # channel catalogue + downloaded videos/exercises
# CTU_KOLIBRI_BIN=                                   # path to the kolibri command if it isn't on PATH
# CTU_KOLIBRI_URL=http://127.0.0.1:8726              # Kolibri's own player, this computer only

# Free test mode through Gemini instead of Anthropic (optional)
# CTU_LLM=gemini
# GEMINI_API_KEY=
# CTU_FREE_MODEL=gemini-3.5-flash

# Fake clock: don't put it here. Use ./demo.sh, which runs on copies. The server refuses to start with
# CTU_NOW unless CTU_DB, CTU_STUDY_REPO and CTU_COACH_MD all point at copies.
# CTU_NOW=2026-11-23T10:30

# PORT is read by run.sh from the environment, not from this file (default 8723).
